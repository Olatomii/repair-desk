generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENT
  ARTISAN
  OPERATOR
}

enum ServiceMode {
  HOME
  WORKSHOP
}

enum ArtisanStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum BookingStatus {
  REQUESTED
  ASSIGNED
  QUOTED
  QUOTE_APPROVED
  IN_PROGRESS
  AWAITING_HANDOVER
  COMPLETED
  CANCELLED
  DISPUTED
}

model User {
  id             String           @id
  name           String
  email          String           @unique
  emailVerified  Boolean          @default(false)
  image          String?
  role           UserRole         @default(CLIENT)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  sessions       Session[]
  accounts       Account[]
  clientBookings Booking[]        @relation("ClientBookings")
  artisanProfile ArtisanProfile?
  bookingEvents  BookingEvent[]   @relation("EventActor")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model City {
  id        String        @id @default(cuid())
  slug      String        @unique
  name      String
  state     String
  country   String        @default("Nigeria")
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  bookings  Booking[]
  artisans  ArtisanCity[]
}

model ServiceCategory {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  description String
  mode        ServiceMode
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  bookings    Booking[]
  artisans    ArtisanService[]
}

model ArtisanProfile {
  id        String          @id @default(cuid())
  userId    String          @unique
  phone     String?
  bio       String?
  status    ArtisanStatus   @default(PENDING)
  rating    Decimal         @default(0) @db.Decimal(3, 2)
  jobsDone  Int             @default(0)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  services  ArtisanService[]
  cities    ArtisanCity[]
  bookings  Booking[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model ArtisanService {
  artisanId String
  serviceId String
  artisan   ArtisanProfile  @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  service   ServiceCategory @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([artisanId, serviceId])
  @@index([serviceId])
}

model ArtisanCity {
  artisanId String
  cityId    String
  artisan   ArtisanProfile @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  city      City           @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@id([artisanId, cityId])
  @@index([cityId])
}

model Booking {
  id                  String          @id @default(cuid())
  reference           String          @unique
  clientId            String
  serviceCategoryId   String
  cityId              String
  artisanId           String?
  status              BookingStatus   @default(REQUESTED)
  problemDescription  String
  address             String?
  preferredDate       DateTime?
  quotedAmount        Decimal?        @db.Decimal(12, 2)
  quoteNote           String?
  currency            String          @default("NGN")
  quotedAt            DateTime?
  quoteApprovedAt     DateTime?
  quoteRejectedAt     DateTime?
  startedAt           DateTime?
  workFinishedAt      DateTime?
  handoverConfirmedAt DateTime?
  completedAt         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  client          User             @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Restrict)
  serviceCategory ServiceCategory  @relation(fields: [serviceCategoryId], references: [id], onDelete: Restrict)
  city            City             @relation(fields: [cityId], references: [id], onDelete: Restrict)
  artisan         ArtisanProfile?  @relation(fields: [artisanId], references: [id], onDelete: SetNull)
  events          BookingEvent[]

  @@index([clientId, createdAt])
  @@index([cityId, status, createdAt])
  @@index([artisanId, status])
}

model BookingEvent {
  id        String   @id @default(cuid())
  bookingId String
  actorId   String?
  type      String
  note      String?
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor   User?   @relation("EventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
}
